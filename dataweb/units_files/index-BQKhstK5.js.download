age:"Language",resetAll:"Reset All",here:"here",and:"and","&":"&",lastUpdated:"Last Updated",lastChecked:"Last Checked",calculating:"Calculating...",compsAnalyzed:"Comps Analyzed",games:"Games",copied:"Copied!",copyLink:"Copy Link",Hard:"Hard",Medium:"Medium",Easy:"Easy",Easy_tooltip:"Performs better/more popular in low elo",Hard_tooltip:"Performs better/more popular in high elo",Fast9_tooltip:"Fast 9 comps can be harder to play",Medium_tooltip:"Performs similarly at all levels","Fast 9":"Fast 9","Fast 8":"Fast 8",Standard:"Standard","lvl 5":"lvl 5","lvl 6":"lvl 6","lvl 7":"lvl 7","Fast 9_tooltip":"Level to 9 as fast as possible, using Experience augments to help. Requires a strong early game & no gold spent rolling.","lvl 5_tooltip":"1 cost reroll comp. Do not buy exp and save as much gold as possible, ideally full loss streaking. Roll to ~33 gold the turn before you hit level 5 for maximum 1 cost odds. Slow roll at lvl 5 staying above 50g. Slow roll at lvl 5 staying above 50g. Roll down if you're losing too much hp, or you only need to hit one or two more copies","lvl 6_tooltip":"2 cost reroll comp. Level to 6 as usual, then slow-roll at lvl 6 staying above 50g unless you need to stabilize.","lvl 7_tooltip":"3 cost reroll comp. Level to 7 as usual, then slow-roll at lvl 7 staying above 50g unless you need to stabilize. If you are contested you may want to go level 8 and try to outlive your opponents.","Fast 8_tooltip":"Level to 8 as fast as possible to secure key 4-cost units before the rest of the lobby.",Standard_tooltip:"Standard levelling intervals. Try to stay above 50g where possible, but don't be afraid to roll to stabilize your comp.",Reroll:"Reroll","Fast 8/9":"Fast 8/9","Reroll Lvl 5":"Reroll Lvl 5","Reroll Lvl 6":"Reroll Lvl 6","Reroll Lvl 7":"Reroll Lvl 7","Filter Comps":"Filter Comps",econ:"Econ",difficulty:"Difficulty",unit:"Unit",trait:"Trait",custom:"Custom",minimumPickRate:"Minimum Pick Rate",title:"Title"},Kke={title:"TFT Team Comps",topCompsTitle:"Top TFT Team Comps",hyperRollTitle:"Hyper Roll Team Comps",doubleUpTitle:"Double Up Team Comps",soulBrawlTitle:"Soul Brawl Team Comps",set35RevivalTitle:"Set 3.5 Revival Team Comps",pbeCompsTitle:"Set {{set}} PBE Team Comps",pbeRevivalTitle:"Set {{set}} PBE Revival Team Comps",revivalTitle:"Set {{set}} Revival Team Comps",subtitle:"A tier list of the best team compositions to play in the current TFT meta, backed by data. Click on a comp to see positioning, levelling, options, early boards and more.",pbeCompsText:"PBE comps for Set",advancedFilters:"Advanced Filters",itemAssistant:"Item Assistant",situational:"Situational",situationalComps:"Situational Comps",situationalCompsTooltip:"Show/Hide Comps that might have situational requirements, such as Hero Augments (based on itemisation).",unhideAllComps:"Unhide All Comps",unpinAllComps:"Unpin All Comps",compsCurrentlyHidden:"Comps currently hidden",compsCurrentlyPinned:"Comps currently pinned",errorGettingCompsData:"Error getting comps data",noCompsFound:"No comps found",modifySearchAndTryAgain:"Please modify your search and try again",noCompsDataForNewSet:"No comps data for the new set yet - check back in a bit or update the patch filter to the previous patch for last set's data",statsPagesHaveData:"The stats pages should have data, check out:",options:"Options",quickStart:"Quick Start",vods:"Vods",counters:"Counters",threeStarUnit:"Three Star Unit",fourStarUnit:"Four Star Unit",missingUnits:"Missing Units",extraUnits:"Extra Units",compareToLiveBoard:"Compare to your live board in the MetaTFT App",importToTeamBuilder:"Import to Team Builder",addUnitsToTeamBuilder:"Add these units to our teambuilder to pin them in game & add shop notifications",noMatchingOptions:"No Matching Options",plusOneTrait:"+1 Trait",sixCosts:"6 Costs",roundWinRate:"Round Win Rate",earlyGameOptionsOnlyInApp:"Early game options are only available in the",earlyGameOptionsOnlyInApp2:"Early game options are only available in the {{link}}MetaTFT App{{link}}",metaTftApp:"MetaTFT App",relyOnAppUsersForData:"We rely on app users to gather this data and generate a decent sample size",ifNoAppSupportPatreon:"If you don't want to use the App, you can always",supportUsOnPatreon:"support us on Patreon",instead:"instead",early:"Early",levelOptions:"Level {{level}} Options",levelOptionsTooltip:"{{percent}}% of players end the game at level {{level}} with an average placement of {{avg}}",headliner:"Headliner",none:"None",levelling:"Levelling",carouselPriority:"Carousel Priority",positioning:"Positioning",tips:"Pro Tips",clickToSeeMore:"Click to see more...",sTierAugments:"S Tier Augments",more:"More",headliners:"Headliners",positioningAndCarouselDataUnavailable:"Positioning and Carousel data temporarily unavailable",standardHyperrollLevelling:"Standard Hyperroll Levelling",levelUp:"Level Up",rerolls:"Rerolls",countPerGame:"Count Per Game",levelToAtStage:"Level to {{level}} at {{stage}}",playersRollTimesOnAverage:"Players roll {{rolls}} times on average at level {{level}}{{additionalText}}",unitPlayRate:"Unit Play Rate",numberOfItems:"Number of Items",searchForUnits:"Search for Units",searchForUnitsDescription:'Separate multiple searches with ("/", "," or " OR ") for OR, ("&", "+", or " AND ") for AND, "!" for NOT and use brackets for nested queries. You can also search for a unit cost, such as "4cost"',itemPlayRate:"Item Play Rate",radiantItemPlayRate:"Radiant Item Play Rate",searchForItems:"Search for Items",searchForItemsDescription:'Separate multiple searches with ("/", "," or " OR ") for OR, ("&", "+", or " AND ") for AND, "!" for NOT and use brackets for nested queries. You can also search for "Support", "Artifact", "Radiant", "Emblem", or a component such as "Bow"',traitPlayRate:"Trait Play Rate",traitLevels:"Trait Levels",searchForTraits:"Search for Traits",searchForTraitsDescription:'Separate multiple searches with ("/", "," or " OR ") for OR, ("&", "+", or " AND ") for AND, "!" for NOT and use brackets for nested queries.',goodAgainst:"Good Against",weakAgainst:"Weak Against",counter:"Counter {{number}}",similarity:"Similarity",loadingVods:"Loading Vods...",noVodsDiscovered:"No Vods discovered yet - try checking again later",recentTwitchStreams:"Recent Twitch Streams",seeMoreForThisComp:"See more for this comp",settings:"Settings",showUnitNames:"Show Unit Names",sortUnitsByCarryPriority:"Sort Units by Carry Priority",traitSymbols:"Trait Symbols",compactModeNoTraits:"Compact Mode (No Traits)",colorblindMode:"Colorblind Mode",minimumPickRate:"Minimum Pick Rate",selectedItemType:"Selected Item Type",selectedItems:"Selected Items",selectItemOrComponent:"Select an Item to add",addAnItem:"Add an Item",itemType:"Item Type",moreInfo:"More Info",info:"Info",aboutThePage:"About the page",aboutPageDescription:"We use Riot's API to analyse match histories and determine how well compositions are performing in the current meta. We get data from every game played in Masters+ and a sample of games from all other ranks. Stats are time weighted (more recent data counts more), so meta shifts are reflected relatively quickly.",compositionsDescription:'Compositions are automatically generated using <a href="https://www.wikipedia.org/wiki/Cluster_analysis" style="textDecoration:None, color: #cbb46c">Clustering Methods</a> to group together similar final comps. This helps to avoid <a href="https://www.wikipedia.org/wiki/Survivorship_bias" style="textDecoration:None, color: #cbb46c">survivorship bias</a> as variations and lvl 7/8/9 comps are all included in the overall stats. This also allows us to detect high performing, off-meta and upcoming builds faster and more accurately than manually maintained tier lists.',faq:"FAQ",faqQuestion1:"Q: Why do so few comps perfom better than 4th?",faqAnswer1:"A: Because the average position in a game is 4.5 (4th is gaining LP, 5th is losing LP). Anything with an average placement below 4.5 is performing well in the current meta.",faqQuestion2:"Q: Why do the option placements differ from the main comp, even if they have the same units?",faqAnswer2:"A: The stats displayed on the main comp represent all variations of that composition. The options stats are only for that exact set of units, and don't take into account how hard it is to get to that state.",faqQuestion3:"Q: Where can I see carousel priority?",faqAnswer3:'A: If you uncheck "Compact View" in the settings menu you will have a layout similar to the old setup including carousel priorities.',moreQuestionsText:'Any more questions or feature requests? Join us on <a href="https://discord.gg/RqN3qPy" style="textDecoration:None, color: #cbb46c">Discord</a> and let us know.',earlyComps:"Early Comps",earlyCompsSubtitle:"Find the best early game comps to play. Data is from Current Patch/last 3 days, Diamond+, and updates hourly",earlyCompsSubtitleWebview:"Find the best early game comps to play. Data is from Current Patch/last 7 days, Diamond+, and updates hourly",earlyCompsAvailableInApp:"Early Game Comps are available in the MetaTFT App",earlyCompsRestrictedToApp:"This is restricted to the MetaTFT App as we rely on app users to help gather this data.",dontWantToDownloadApp:"Don't want to download the app? You can always support us on Patreon to access this and more.",alreadySupportingLinkAccount:"Already Supporting on Patreon or Overwolf? Link your account!",roundsAnalyzed:"Rounds Analyzed:",sort:"Sort:",searchUnitOrTrait:"Search Unit or Trait",stage:"Stage",finalPlace:"Final Place",count:"Count",avgFinalPlace:"Avg Final Place",unitStarLevel:"Unit Star Level",bestItemHolders:"Best Item Holders",unit:"Unit",frequency:"Frequency",nextStage:"Next Stage",previousStage:"Previous Stage",next:"Next",prev:"Prev",wentOut:"Went Out",optionsAndOverview:"Options & Overview",transitions:"Transitions",unitsAndItems:"Units & Items",fetchingCompDetails:"Fetching comp details",errorLoadingCompData:"Error loading comp data",signOut:"Sign out",becomeASupporter:"Become a Supporter",becomeAP